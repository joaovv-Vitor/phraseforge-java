# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phraseforge
DB_USERNAME=phraseforge
DB_PASSWORD=phraseforge
MYSQL_ROOT_PASSWORD=phraseforge-root

# Backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional one-time administrator bootstrap. Remove the password after first use.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
JWT_SECRET=
JWT_ISSUER=phraseforge
JWT_ACCESS_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
# Use false only for local HTTP development. Keep true in HTTPS environments.
COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=PT1M

# Frontend (Vite; use frontend/.env.local for local dev)
VITE_API_URL=/api/v1
